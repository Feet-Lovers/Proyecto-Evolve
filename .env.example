# API Key de Anthropic (obligatoria)
ANTHROPIC_API_KEY=your_api_key_here

# Backend
HOST=0.0.0.0
PORT=8000
PROXY_PORT=8080

# Módulo IA
BACKEND_URL=http://backend:8000
MOCK_PLAYWRIGHT=false

# --- Autenticación por usuario (obligatorias) ---
# NO se rellenan a mano ni se copian de ningún sitio: las genera
#     python3 tools/generar-credenciales.py
# que las escribe directamente en el .env sin mostrarlas por pantalla (la bitácora
# de trabajo registra la salida de los comandos en texto plano).
#
# Si faltan, el backend NO arranca. Es deliberado: un valor por defecto en el
# código permitiría a cualquiera que lea este repositorio —que es público— firmar
# sus propios tokens y entrar como cualquier usuario.
JWT_SECRET=
# Código de invitación del registro. También obligatorio y sin valor por defecto:
# el registro NO es abierto porque esta herramienta lanza tráfico contra terceros, y
# con altas anónimas cualquiera atacaría a quien quisiera desde nuestra
# infraestructura. Si la variable faltara, el registro quedaría abierto sin que nadie
# se diera cuenta, así que el backend prefiere no arrancar.
REGISTRO_CODIGO=
# Usuarios de ARRANQUE (opcional), como nombre:hash_bcrypt separados por comas.
# Nunca contraseñas en claro. Sirven para tener con quien entrar en un despliegue
# nuevo; los usuarios normales se crean ellos mismos en POST /api/auth/registro.
HOOKSUITE_USERS=
# Validez del token en horas.
JWT_HORAS_VALIDEZ=8
# Dónde vive el almacén de cuentas dentro del contenedor (volumen 'usuarios').
USUARIOS_FICHERO=/data/usuarios.json
